# Hecy Blog shared configuration
# Development example. Set NODE_ENV=production in the deployed environment.
NODE_ENV=development

# Admin
ADMIN_USERNAME=hecy
# Development fallback; set this locally. Production must use ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
ADMIN_ORIGIN=http://localhost:3001
BUILD_WEBHOOK_SECRET=

# PostgreSQL (leave blank for the in-memory development preview)
DATABASE_URL=
DATABASE_POOL_MAX=5

# Public site -> read-only admin API
CONTENT_API_URL=http://localhost:3001/api/public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ORIGIN=http://localhost:3000
# Set to true only for an intentional local/demo build without the API.
ALLOW_SEED_FALLBACK=false

# Frontend content mode:
#   isr (default in Docker) — 动态渲染，发布/改设置实时生效，无需构建
#   local                   — 本机静态导出构建（VPS 单机，需 SITE_BUILD_DIR）
#   未设置                   — 远程触发：Vercel Deploy Hook 或 GitHub Actions
BUILD_MODE=isr
SITE_BUILD_DIR=
VERCEL_DEPLOY_HOOK_URL=
# GitHub Actions repository_dispatch (remote build mode)
GITHUB_OWNER=LAOHO0
GITHUB_REPO=Hecy-Blog
GITHUB_TOKEN=

# Managed Postgres over TLS (Neon/Supabase/RDS); local Postgres can stay false.
DATABASE_SSL=false

# Optional S3-compatible media storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
